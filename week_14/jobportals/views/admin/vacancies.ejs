<div class="flex items-start justify-between mb-6">
  <div>
    <p class="text-sm text-slate-500">Admin • Vacancies</p>
    <h1 class="text-2xl font-semibold text-slate-900">Vacancy Management</h1>
    <p class="text-sm text-slate-500 mt-1">Kelola lowongan, status, dan tindakan cepat.</p>
  </div>
  <a
    href="/admin/vacancies/create"
    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium shadow-sm hover:bg-indigo-700 transition"
  >
    <span class="text-lg leading-none">＋</span>
    Create Vacancy
  </a>
</div>

<!-- FILTER BAR -->
<form
  class="mb-5 flex flex-wrap items-center gap-3 bg-white border border-slate-200 rounded-lg px-4 py-3 shadow-sm"
  method="get"
  action="/admin/vacancies"
>
  <label class="text-sm text-slate-600">Filter by status</label>

  <select
    name="status"
    onchange="this.form.submit()"
    class="border border-slate-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-200"
  >
    <option value="" <%= !filterStatus ? 'selected' : '' %>>All</option>
    <option value="ACTIVE" <%= filterStatus === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
    <option value="CLOSED" <%= filterStatus === 'CLOSED' ? 'selected' : '' %>>CLOSED</option>
  </select>

  <% if (filterStatus) { %>
    <a href="/admin/vacancies" class="text-sm text-indigo-600 hover:underline">Reset</a>
  <% } %>
</form>

<!-- TABLE -->
<div class="bg-white rounded-xl shadow border border-slate-200 overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-slate-600">
      <tr>
        <th class="p-3 text-left font-semibold">Title</th>
        <th class="p-3 text-left font-semibold">Company</th>
        <th class="p-3 text-left font-semibold">Type</th>
        <th class="p-3 text-left font-semibold">Location</th>
        <th class="p-3 text-left font-semibold">Status</th>
        <th class="p-3 text-center font-semibold">Actions</th>
      </tr>
    </thead>

    <tbody>
      <% vacancies.forEach(v => { %>
        <tr class="border-t border-slate-100 hover:bg-slate-50 transition">
          <td class="p-3 font-medium text-slate-900"><%= v.title %></td>
          <td class="p-3 text-slate-700"><%= v.company %></td>
          <td class="p-3 text-slate-700"><%= v.jobType || '-' %></td>
          <td class="p-3 text-slate-700"><%= v.location %></td>
          <td class="p-3">
            <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-semibold
              <%= v.status === 'ACTIVE'
                ? 'bg-green-50 text-green-700 border border-green-100'
                : 'bg-amber-50 text-amber-700 border border-amber-100'
              %>">
              <span class="w-2 h-2 rounded-full <%= v.status === 'ACTIVE' ? 'bg-green-500' : 'bg-amber-500' %>"></span>
              <%= v.status %>
            </span>
          </td>

          <td class="p-3 text-center">
            <div class="inline-flex items-center gap-2">
              <a
                href="/admin/vacancies/<%= v.id %>/edit"
                class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
              >
                Edit
              </a>

              <button
                onclick="deleteVacancy(<%= v.id %>)"
                class="px-3 py-1.5 rounded-lg bg-red-50 text-red-600 border border-red-100 hover:bg-red-100 transition"
              >
                Delete
              </button>
            </div>
          </td>
        </tr>
      <% }) %>

      <% if (vacancies.length === 0) { %>
        <tr>
          <td colspan="6" class="p-8 text-center text-slate-500">
            Belum ada lowongan. Mulai dengan membuat vacancy baru.
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<script src="/javascripts/api.js"></script>
<script>
  async function deleteVacancy(id) {
    if (!confirm("Are you sure you want to delete this vacancy?")) return;

    try {
      await apiRequest(`/api/admin/vacancies/${id}`, "DELETE");
      window.location.reload();
    } catch (err) {
      alert("Failed to delete vacancy");
    }
  }
</script>
