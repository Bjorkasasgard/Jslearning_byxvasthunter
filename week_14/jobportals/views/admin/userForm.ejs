<h1 class="text-2xl font-bold mb-4"><%= user ? 'Edit User' : 'Create User' %></h1>

<form id="userForm" class="bg-white p-4 rounded shadow w-full sm:w-2/3">
  <div class="mb-3">
    <label class="block text-sm text-slate-600">Name</label>
    <input id="name" name="name" class="border p-2 w-full" value="<%= user ? user.name : '' %>" required />
  </div>

  <div class="mb-3">
    <label class="block text-sm text-slate-600">Email</label>
    <input id="email" name="email" class="border p-2 w-full" value="<%= user ? user.email : '' %>" required />
  </div>

  <div class="mb-3">
    <label class="block text-sm text-slate-600">Role</label>
    <select id="role" name="role" class="border p-2 w-full">
      <option value="MEMBER" <%= !user || user.role === 'MEMBER' ? 'selected' : '' %>>MEMBER</option>
      <option value="ADMIN" <%= user && user.role === 'ADMIN' ? 'selected' : '' %>>ADMIN</option>
    </select>
  </div>

  <div class="mb-3">
    <label class="block text-sm text-slate-600">Password <small class="text-xs">(leave blank to keep)</small></label>
    <input id="password" name="password" type="password" class="border p-2 w-full" <%= user ? '' : 'required' %> />
    <div id="passwordError" class="text-xs text-red-600 mt-1 hidden">Password must be at least 6 characters.</div>
  </div>

  <div class="flex gap-3">
    <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded">Save</button>
    <a href="/admin/users" class="px-4 py-2 rounded border">Cancel</a>
  </div>
</form>

<script src="/javascripts/api.js"></script>
<script>
  const userData = <%- JSON.stringify(user || null) %>;
  const isEdit = Boolean(userData && userData.id);
  const userId = userData?.id;

  document.getElementById('userForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const payload = {
      name: document.getElementById('name').value,
      email: document.getElementById('email').value,
      role: document.getElementById('role').value,
    };

    const pass = document.getElementById('password').value;
    if (pass) payload.password = pass;

    const url = isEdit ? `/api/admin/users/${userId}` : '/api/admin/users';
    const method = isEdit ? 'PUT' : 'POST';

    try {
      if (payload.password !== undefined && payload.password !== "" && payload.password.length < 6) {
        document.getElementById('passwordError').classList.remove('hidden');
        return;
      } else {
        document.getElementById('passwordError').classList.add('hidden');
      }
      await apiRequest(url, method, payload);
      window.location.href = '/admin/users';
    } catch (err) {
      alert(err.message || 'Operation failed');
      console.error(err);
    }
  });
</script>
