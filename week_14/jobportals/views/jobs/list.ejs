<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="flex flex-col gap-6">

    <!-- Job Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      <% jobs.forEach(job=> { %>
        <article class="group bg-white rounded-2xl border border-slate-200
                 shadow-sm hover:shadow-md hover:border-indigo-300
                 transition flex flex-col">

          <!-- HEADER -->
          <div class="p-5 flex items-start justify-between gap-4">

            <!-- TITLE + META -->
            <div class="space-y-1">
              <h2 class="text-lg font-semibold text-slate-900 leading-snug
                       group-hover:text-indigo-700 transition">
                <%= job.title %>
              </h2>

              <div class="flex flex-wrap items-center gap-2 text-sm text-slate-600">

                <!-- COMPANY -->
                <div class="flex items-center gap-1">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 21h18M9 8h6M9 12h6M9 16h6M5 21V5a2 2 0 012-2h10a2 2 0 012 2v16" />
                  </svg>
                  <span class="font-medium">
                    <%= job.company %>
                  </span>
                </div>

                <span>•</span>

                <!-- LOCATION -->
                <div class="flex items-center gap-1">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 11c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z" />
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 22s8-4.5 8-11a8 8 0 10-16 0c0 6.5 8 11 8 11z" />
                  </svg>
                  <span>
                    <%= job.location %>
                  </span>
                </div>

                <% if (job.jobType) { %>
                  <span>•</span>
                  <span class="inline-flex items-center px-2 py-0.5
                           text-xs rounded-md bg-slate-100 text-slate-700">
                    <%= job.jobType.toLowerCase() %>
                  </span>
                  <% } %>
              </div>
            </div>

            <!-- STATUS -->
            <span class="shrink-0 inline-flex items-center px-3 py-1 rounded-full
                     text-xs font-semibold border
              <%= job.status === 'CLOSED'
                ? 'bg-red-50 text-red-700 border-red-200'
                : 'bg-green-50 text-green-700 border-green-200' %>">
              <%= job.status || 'ACTIVE' %>
            </span>
          </div>

          <!-- BODY -->
          <!-- Body -->
          <div class="px-5 pb-6 text-sm text-slate-700 leading-relaxed">
            <p class="line-clamp-3">
              <%= job.description %>
            </p>
          </div>


          <!-- FOOTER -->
          <div class="mt-auto border-t px-5 py-4 flex items-center justify-between">

            <!-- CTA -->
            <% if (job && job.id) { %>
              <a href="/jobs/<%= job.id %>" class="inline-flex items-center gap-2
                       text-indigo-700 font-medium
                       hover:text-indigo-900 transition">
                View details
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
              <% } else { %>
                <span class="text-sm text-slate-400">Unavailable</span>
                <% } %>

                  <!-- USER LABEL -->
                  <span class="inline-flex items-center gap-1 text-xs px-2 py-1 rounded-md
              <%= currentUser
                ? 'bg-indigo-50 text-indigo-700'
                : 'bg-slate-100 text-slate-600' %>">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M5.121 17.804A13.937 13.937 0 0112 15c2.5 0 4.847.655 6.879 1.804M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <%= currentUser ? 'Member access' : 'Guest preview' %>
                  </span>

          </div>
        </article>
        <% }) %>
    </div>

    <!-- PAGINATION (tetap) -->
    <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
      <nav class="mt-6 flex items-center justify-center gap-2 flex-wrap">
        <% const prev=currentPage - 1; const next=currentPage + 1; %>

          <a href="/jobs?page=<%= Math.max(1, prev) %>&limit=<%= limit %>" class="px-4 py-2 rounded-lg border bg-white hover:bg-slate-50 text-sm
          <%= currentPage === 1 ? 'opacity-50 pointer-events-none' : '' %>">
            Prev
          </a>

          <% for (let i=1; i <=totalPages; i++) { %>
            <a href="/jobs?page=<%= i %>&limit=<%= limit %>" class="px-4 py-2 rounded-lg border text-sm
            <%= i === currentPage
              ? 'bg-slate-900 text-white border-slate-900'
              : 'bg-white hover:bg-slate-50' %>">
              <%= i %>
            </a>
            <% } %>

              <a href="/jobs?page=<%= Math.min(totalPages, next) %>&limit=<%= limit %>" class="px-4 py-2 rounded-lg border bg-white hover:bg-slate-50 text-sm
          <%= currentPage === totalPages ? 'opacity-50 pointer-events-none' : '' %>">
                Next
              </a>
      </nav>
      <% } %>

  </div>
</div>