<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %> - Post Article</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">PostArticle</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/">Back to Home</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Article Header -->
                <article class="mb-5">
                    <h1 class="fw-bolder mb-1"><%= post.title %></h1>
                    <div class="text-muted fst-italic mb-2">
                        Posted on <%= new Date(post.createdAt).toLocaleDateString() %> by <%= post.author.name %>
                    </div>
                    <hr>
                    <!-- Post content-->
                    <section class="mb-5">
                        <p class="fs-5 mb-4"><%= post.content %></p>
                    </section>
                </article>

                <!-- Comments section -->
                <section class="mb-5">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h5 class="card-title">Comments</h5>
                            <% if (post.comments && post.comments.length > 0) { %>
                                <% post.comments.forEach(comment => { %>
                                    <div class="d-flex mb-3 border-bottom pb-2">
                                        <div class="flex-shrink-0"><img class="rounded-circle" src="https://dummyimage.com/50x50/ced4da/6c757d.jpg" alt="..." /></div>
                                        <div class="ms-3">
                                            <div class="fw-bold"><%= comment.author.name %></div>
                                            <%= comment.content %>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted">No comments yet.</p>
                            <% } %>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</body>
</html>
