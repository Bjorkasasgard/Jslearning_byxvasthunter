<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post Article - Home</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">Bastian Article</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="navbar-nav ms-auto">
                    <% if (user) { %>
                        <span class="nav-link text-light">Hi, <%= user.name %></span>
                        <a class="nav-link" href="/dashboard">Dashboard</a>
                        <form action="/logout" method="POST" class="d-inline">
                            <button class="btn nav-link" type="submit">Logout</button>
                        </form>
                    <% } else { %>
                        <a class="nav-link" href="/login">Login</a>
                        <a class="nav-link" href="/register">Register</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container">
        <h1 class="mb-4">Welcome to bastian article</h1>
        <div class="row">
            <% if (posts.length > 0) { %>
                <% posts.forEach(post => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><%= post.title %></h5>
                                <h6 class="card-subtitle mb-2 text-muted">By <%= post.author.name %></h6>
                                <p class="card-text"><%= post.content.substring(0, 100) %>...</p>
                                <a href="/posts/<%= post.id %>" class="btn btn-primary btn-sm">Read More</a>
                            </div>
                            <div class="card-footer text-muted small">
                                <%= new Date(post.createdAt).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12">
                    <div class="alert alert-info">No article posts found.</div>
                </div>
            <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
