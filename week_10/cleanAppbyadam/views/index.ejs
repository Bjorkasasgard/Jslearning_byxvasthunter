<!DOCTYPE html>
<html>
  <head>
    <title>Users List</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50 p-6">
    <div class="max-w-6xl mx-auto">
      <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
        <div>
          <h1 class="text-3xl font-bold text-gray-800">User managemant</h1>
          <p class="text-sm text-gray-500">Manage user, delete and edit</p>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <input id="search" type="search" placeholder="Search name, email or phone..." class="flex-1 sm:w-64 border border-gray-200 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" />
          <a href="/submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition">Add New</a>
        </div>
      </header>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="mb-4 p-3 rounded-md bg-green-50 border border-green-200 text-green-700"> <%= message %> </div>
      <% } %>

      <div class="bg-white rounded-lg shadow overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Phone</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody id="users-tbody" class="bg-white divide-y divide-gray-200">
            <% if (users && users.length > 0) { %>
              <% users.forEach(function(user) { %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700" title="<%= user.id %>">
                    <span class="font-mono text-xs text-gray-500"><%= user.id.slice(0,8) %>…</span>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900"><%= user.name %></td>
                  <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500"><%= user.email %></td>
                  <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500"><%= user.phone || '-' %></td>
                  <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">
                    <a href="/edit/<%= user.id %>" class="inline-flex items-center gap-2 border border-gray-200 text-gray-800 px-3 py-1 rounded-md hover:bg-gray-50">Edit</a>
                    <form action="/delete/<%= user.id %>" method="POST" class="inline-block ml-3" onsubmit="return confirm('Are you sure you want to delete this user?')">
                      <button type="submit" class="inline-flex items-center gap-2 bg-red-50 border border-red-200 text-red-700 px-3 py-1 rounded-md hover:bg-red-100">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="px-4 py-6 text-center text-sm text-gray-500">No users found. Click "Add New" to create a user.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <script>
      // Simple client-side search: filters rows by name/email/phone
      const searchEl = document.getElementById('search');
      if (searchEl) {
        searchEl.addEventListener('input', function (e) {
          const q = e.target.value.toLowerCase().trim();
          const rows = document.querySelectorAll('#users-tbody tr');
          rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = q === '' || text.indexOf(q) !== -1 ? '' : 'none';
          });
        });
      }
    </script>
  </body>
</html>