<div class="w-full max-w-md bg-white/90 backdrop-blur rounded-2xl shadow-sm border px-6 py-8 mx-auto">
  <div class="mb-6 text-center space-y-1">
    <p class="text-xs uppercase tracking-wide text-slate-500">Welcome back</p>
    <h1 class="text-2xl font-bold text-slate-900">Sign in</h1>
    <p class="text-sm text-slate-600">Access your job applications and profile.</p>
  </div>

  <form id="loginForm" class="space-y-4">
    <div id="loginError" class="text-sm text-red-600 mb-2 hidden"></div>
    <div class="space-y-2">
      <label class="text-sm text-slate-600">Email</label>
      <input id="email" type="email" required class="border rounded-lg p-3 w-full focus:outline-none focus:ring-2 focus:ring-indigo-200" placeholder="you@example.com" />
    </div>

    <div class="space-y-2">
      <label class="text-sm text-slate-600">Password</label>
      <input id="password" type="password" required class="border rounded-lg p-3 w-full focus:outline-none focus:ring-2 focus:ring-indigo-200" placeholder="••••••••" />
    </div>

    <button class="w-full bg-indigo-600 text-white px-4 py-2.5 rounded-lg hover:bg-indigo-700 transition font-semibold">Login</button>
  </form>

  <p class="text-sm text-center text-slate-600 mt-6">New here? <a href="/auth/register" class="text-indigo-600 hover:text-indigo-700 font-semibold">Create account</a></p>
</div>

<script src="/javascripts/auth.js"></script>
<script>
  // Error handler for login
  document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
    const errorDiv = document.getElementById('loginError');
    if (errorDiv) errorDiv.classList.add('hidden');
    // error handled in auth.js, but we can show here too
    setTimeout(() => {
      if (window.lastLoginError) {
        errorDiv.textContent = window.lastLoginError;
        errorDiv.classList.remove('hidden');
        window.lastLoginError = null;
      }
    }, 100);
  });
</script>
