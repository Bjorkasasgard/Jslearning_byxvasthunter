<section class="space-y-10">

  <% if (!current) { %>
    <!-- NOT AUTH -->
    <div class="min-h-[60vh] flex items-center justify-center">
      <div class="bg-white rounded-2xl border shadow-sm px-8 py-10 text-center max-w-md w-full">
        <h1 class="text-2xl font-bold text-slate-900 mb-2">
          Access Restricted
        </h1>
        <p class="text-slate-600 mb-6">
          Please sign in to view your job applications.
        </p>
        <a
          href="/auth/login"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg
                 bg-indigo-600 text-white hover:bg-indigo-700 font-semibold transition"
        >
          Login
        </a>
      </div>
    </div>

  <% } else { %>

    <!-- HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div>
        <h2 class="text-xl font-semibold text-slate-900">
          My Applications
        </h2>
        <p class="text-sm text-slate-500">
          Track the jobs you’ve applied for
        </p>
      </div>

      <span class="text-sm text-slate-500">
        <%= applications.length %> submitted
      </span>
    </div>

    <!-- LIST -->
    <ul class="space-y-4">

      <% applications.forEach(a => { %>
        <li
          class="bg-white border rounded-2xl p-5 shadow-sm
                 hover:shadow-md transition group"
        >

          <!-- TOP -->
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

            <!-- JOB INFO -->
            <div class="space-y-1">
              <h3 class="font-semibold text-slate-900 group-hover:text-indigo-600 transition">
                <%= a.jobVacancy?.title || 'Unknown position' %>
              </h3>

              <div class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
                <span><%= a.jobVacancy?.company || '—' %></span>
                <span>•</span>
                <span><%= a.jobVacancy?.location || '—' %></span>
                <span>•</span>
                <span>
                  Applied
                  <%= a.createdAt ? new Date(a.createdAt).toLocaleDateString() : '' %>
                </span>
              </div>
            </div>

            <!-- STATUS -->
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold
              <%= a.status === 'PENDING'
                ? 'bg-yellow-50 text-yellow-700 border border-yellow-100'
                : a.status === 'ACCEPTED'
                ? 'bg-green-50 text-green-700 border border-green-100'
                : 'bg-red-50 text-red-700 border border-red-100'
              %>"
            >
              <%= a.status %>
            </span>

          </div>

          <!-- META -->
          <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-slate-600">

            <div class="flex items-center gap-1">
              <span class="font-medium">Job Type:</span>
              <span><%= a.jobVacancy?.jobType || '-' %></span>
            </div>

            <% if (a.jobVacancy?.salary) { %>
              <div class="flex items-center gap-1">
                <span class="font-medium">Salary:</span>
                <span><%= a.jobVacancy.salary %></span>
              </div>
            <% } %>

            <div class="flex items-center gap-1">
              <span class="font-medium">Questions:</span>
              <span><%= a.answers?.length || 0 %> answered</span>
            </div>

          </div>

          <div class="mt-3 flex flex-wrap items-center gap-3 text-sm">
            <% if (a.coverLetterFile) { %>
              <a href="<%= a.coverLetterFile %>" target="_blank" class="text-indigo-600 font-medium hover:underline">Cover letter (PDF)</a>
            <% } else if (a.coverLetter) { %>
              <span class="text-slate-600">Cover letter submitted</span>
            <% } else { %>
              <span class="text-slate-400">No cover letter</span>
            <% } %>

            <span class="text-slate-300">•</span>

            <% const resumeSrc = a.resumeLink || a.user?.resume; %>
            <% if (resumeSrc) { %>
              <a href="<%= resumeSrc %>" target="_blank" class="text-indigo-600 font-medium hover:underline">Resume</a>
            <% } else { %>
              <span class="text-slate-400">No resume</span>
            <% } %>

            <span class="text-slate-300">•</span>

            <a href="/applications" class="text-slate-600 hover:underline">View all applications</a>
          </div>

        </li>
      <% }) %>

      <% if (!applications.length) { %>
        <li class="bg-white border rounded-2xl p-8 text-center">
          <h3 class="font-medium text-slate-700 mb-1">
            No applications yet
          </h3>
          <p class="text-sm text-slate-500">
            Start applying to jobs and track them here.
          </p>
        </li>
      <% } %>

    </ul>

  <% } %>
</section>
