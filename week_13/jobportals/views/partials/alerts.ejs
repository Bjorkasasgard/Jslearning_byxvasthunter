<% if (alerts && alerts.length) { %>
  <div class="space-y-2 mb-4" aria-live="polite" aria-atomic="true">
    <% alerts.forEach(a => { %>
      <div class="flex items-center justify-between px-4 py-3 rounded-lg text-sm
                  <%= a.type === 'success' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-red-50 text-red-700 border border-red-200' %>">
        <span><%= a.text %></span>
        <button type="button" class="alert-close ml-4 text-slate-500 hover:text-slate-700">✕</button>
      </div>
    <% }) %>
  </div>
<% } %>