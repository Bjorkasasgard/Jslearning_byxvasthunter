<section class="max-w-6xl mx-auto px-4 py-6 space-y-6">

  <!-- ================= HEADER ================= -->
  <header class="bg-white border rounded-2xl p-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:justify-between lg:items-start">

      <!-- LEFT -->
      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">
          <%= job.title %>
        </h1>

        <!-- META -->
        <div class="flex flex-wrap items-center gap-3 text-sm text-slate-600">

          <!-- Company -->
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M3 21h18M9 8h6M9 12h6M9 16h6M5 21V5a2 2 0 012-2h10a2 2 0 012 2v16" />
            </svg>
            <span class="font-medium text-slate-800">
              <%= job.company %>
            </span>
          </span>

          <span class="text-slate-300">•</span>

          <!-- Location -->
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M12 21s6-5.7 6-10a6 6 0 10-12 0c0 4.3 6 10 6 10z" />
              <circle cx="12" cy="11" r="2" />
            </svg>
            <%= job.location %>
          </span>

          <% if (job.salary) { %>
            <span class="text-slate-300">•</span>

            <!-- Salary Label -->
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full 
             bg-green-50 text-green-700 border border-green-200 
             text-xs sm:text-sm font-medium">

                <span>
                  <%= job.salary %>
                </span>
              </span>
            </div>
            <% } %>

        </div>
      </div>

      <!-- RIGHT TAGS -->
      <div class="flex flex-wrap gap-2 text-xs">
        <% if (job.jobType) { %>
          <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-700 font-medium">
            <%= job.jobType %>
          </span>
          <% } %>

            <span class="px-3 py-1 rounded-full font-semibold
          <%= job.status === 'CLOSED'
            ? 'bg-red-50 text-red-700'
            : 'bg-indigo-50 text-indigo-700' %>">
              <%= job.status %>
            </span>
      </div>

    </div>
  </header>

  <!-- ================= CONTENT ================= -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- LEFT CONTENT -->
    <main class="lg:col-span-2 space-y-6">

      <!-- DESCRIPTION -->
      <section class="bg-white border rounded-2xl p-6">
        <h2 class="font-semibold text-lg mb-3">Job Description</h2>
        <p class="text-slate-700 whitespace-pre-line leading-relaxed">
          <%= job.description %>
        </p>
      </section>

      <!-- REQUIREMENTS -->
      <% if (job.requirements) { %>
        <section class="bg-white border rounded-2xl p-6">
          <h2 class="font-semibold text-lg mb-3">Requirements</h2>
          <p class="text-slate-700 whitespace-pre-line leading-relaxed">
            <%= job.requirements %>
          </p>
        </section>
        <% } %>

    </main>

    <!-- ================= APPLY BOX ================= -->
    <aside id="applyBox" class="bg-white border rounded-2xl p-6 space-y-4
         lg:sticky lg:top-6 h-fit">

      <h3 class="font-semibold text-lg mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M22 2 11 13" />
          <path d="M22 2 15 22 11 13 2 9 22 2" />
        </svg>
        Apply for this job
      </h3>

      <% if (!currentUser) { %>
        <div class="text-sm text-slate-600 bg-slate-50 p-4 rounded-xl text-center">
          Please <a href="/auth/login" class="text-indigo-600 font-medium hover:underline">sign in</a> to apply.
        </div>

      <% } else { %>

        <% if (job.status === 'CLOSED') { %>
          <div class="text-sm text-slate-600 bg-slate-50 p-4 rounded-xl text-center">
            Applications for this position are closed.
          </div>
        <% } else { %>

          <div class="space-y-3">
            <div class="h-1 w-full bg-slate-100 rounded-full overflow-hidden">
              <div id="stepProgress" class="h-full w-1/3 bg-indigo-600 transition-all duration-300"></div>
            </div>
            <div class="flex items-center justify-between text-xs">
              <span id="stepLabel" class="font-medium text-indigo-600">Step 1 of 3</span>
              <span id="stepName" class="text-slate-500">Profile location</span>
            </div>
          </div>

          <div id="applyAlert" class="hidden text-xs rounded-lg border px-3 py-2"></div>

          <form id="applyWizard" class="space-y-4" data-job-id="<%= job.id %>">

            <!-- STEP 1: Location -->
            <div class="step space-y-2">
              <div class="flex items-center justify-between text-sm">
                <label class="font-medium">Where are you located?</label>
                <span class="text-slate-400">Required</span>
              </div>
              <input type="text" id="userLocation" value="<%= currentUser.location || '' %>"
                class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-indigo-200" placeholder="City, Country" />
              <p class="text-xs text-slate-500">We use this to confirm work eligibility and proximity.</p>
            </div>

            <!-- STEP 2: Cover letter + resume -->
            <div class="step hidden space-y-3">
              <div class="flex items-center justify-between text-sm">
                <label for="coverLetter" class="font-medium">Tell us about you</label>
                <span class="text-slate-400">Recommended</span>
              </div>
              <textarea id="coverLetter" class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-indigo-200" rows="5"
                placeholder="Briefly introduce yourself and why you are a fit."></textarea>
              <p class="text-xs text-slate-500">Highlight relevant experience, notice period, and availability.</p>

              <div class="space-y-1">
                <div class="flex items-center justify-between text-sm">
                  <label for="resumeLink" class="font-medium">Resume link</label>
                  <span class="text-slate-400">Required</span>
                </div>
                <% if (currentUser.resume) { %>
                  <div class="text-xs bg-slate-50 border rounded-lg p-3 flex items-center gap-2">
                    <span>📄</span>
                    <a href="<%= currentUser.resume %>" target="_blank" class="text-indigo-600 hover:underline">
                      <%= currentUser.resume.split('/').pop() %>
                    </a>
                    <span class="text-slate-400">(default)</span>
                  </div>
                <% } %>
                <input type="url" id="resumeLink" value="<%= currentUser.resume || '' %>"
                  class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-indigo-200" placeholder="https://..." required />
                <p class="text-xs text-slate-500">Paste a link to your resume (Google Drive, Dropbox, etc.). Make sure link is viewable.</p>
              </div>
            </div>

            <!-- STEP 3: Employer questions -->
            <div class="step hidden space-y-3">
              <div class="flex items-center justify-between text-sm">
                <span class="font-medium">Employer questions</span>
                <span class="text-slate-400"><%= (job.questions && job.questions.length) ? 'Required' : 'Optional' %></span>
              </div>

              <% if (job.questions && job.questions.length) { %>
                <% job.questions.forEach((q, idx)=> { %>
                  <div class="space-y-1">
                    <p class="text-sm text-slate-700">
                      <%= q %>
                    </p>
                    <textarea class="question-answer w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-indigo-200" rows="3"
                      data-question-index="<%= idx %>" required></textarea>
                  </div>
                <% }) %>
              <% } else { %>
                <p class="text-sm text-slate-600">No additional questions from the employer.</p>
              <% } %>
            </div>

            <!-- NAV -->
            <div class="flex items-center justify-between pt-2 gap-3">
              <button type="button" id="prevBtn" class="text-sm text-slate-500 hidden">
                Back
              </button>

              <button type="button" id="nextBtn" class="ml-auto bg-indigo-600 hover:bg-indigo-700
                     text-white px-4 py-2 rounded-lg text-sm font-medium">
                Continue
              </button>
            </div>

          </form>

        <% } %>

      <% } %>
    </aside>

  </div>
<script src="/javascripts/applyWizard.js"></script>
</section>