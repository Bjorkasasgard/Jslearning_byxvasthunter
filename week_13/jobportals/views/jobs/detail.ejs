<section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <article class="lg:col-span-2 bg-white rounded-2xl shadow-sm p-6 border">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-xs uppercase tracking-wide text-slate-500">Member view</p>
        <h1 class="text-2xl font-bold text-slate-900"><%= job.title %></h1>
        <p class="mt-2 text-slate-700"><span class="font-medium">Company:</span> <%= job.company %></p>
        <p class="text-slate-700"><span class="font-medium">Location:</span> <%= job.location %></p>
      </div>
      <span class="text-xs px-2 py-1 rounded-full bg-green-50 text-green-700 border border-green-200"><%= job.status || 'ACTIVE' %></span>
    </div>

    <div class="mt-5 space-y-3">
      <h2 class="text-lg font-semibold">Description</h2>
      <p class="text-slate-700 leading-relaxed"><%= job.description %></p>
    </div>
  </article>

  <aside class="bg-white rounded-2xl shadow-sm p-6 border space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs uppercase tracking-wide text-slate-500">Apply</p>
        <h2 class="text-lg font-semibold text-slate-900">Cover Letter</h2>
      </div>
      <span class="text-xs px-2 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">Member</span>
    </div>

    <form id="applyForm" class="space-y-3">
      <label class="block text-sm text-slate-600">Explain why you are a great fit</label>
      <textarea
        class="w-full border rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-indigo-200"
        placeholder="Highlight relevant experience, motivation, and availability"
        id="coverLetter"
        rows="6"
        required
      ></textarea>

      <button
        type="submit"
        class="w-full bg-indigo-600 text-white px-4 py-2.5 rounded-lg hover:bg-indigo-700 transition font-semibold"
      >
        Apply for this job
      </button>
    </form>

    <ul class="text-xs text-slate-500 space-y-1">
      <li>• Your application will be saved under My Applications.</li>
      <li>• You can update your profile anytime.</li>
    </ul>
  </aside>
</section>

<script src="/javascripts/api.js"></script>
<script>
  document.getElementById("applyForm")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const coverLetter = document.getElementById("coverLetter").value;

    await apiRequest("/api/vacancies/<%= job.id %>/apply", "POST", {
      coverLetter
    });

    alert("Application submitted");
  });
</script>
