<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="flex flex-col gap-6">

    <!-- Job Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      <% jobs.forEach(job => { %>
        <article
          class="group bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-indigo-300 transition flex flex-col">

          <!-- Header -->
          <div class="p-5 flex items-start justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold text-slate-900 leading-snug group-hover:text-indigo-700 transition">
                <%= job.title %>
              </h2>

              <p class="mt-1 text-sm text-slate-600">
                <span class="font-medium"><%= job.company %></span>
                <span class="mx-1">•</span>
                <span><%= job.location %></span>
              </p>
            </div>

            <span class="shrink-0 text-xs font-medium px-3 py-1 rounded-full border
              <%= job.status === 'CLOSED'
                ? 'bg-red-50 text-red-700 border-red-200'
                : 'bg-green-50 text-green-700 border-green-200' %>">
              <%= job.status || 'ACTIVE' %>
            </span>
          </div>

          <!-- Body -->
          <div class="px-5 pb-4 text-sm text-slate-700 leading-relaxed line-clamp-3">
            <%= job.description %>
          </div>

          <!-- Footer -->
          <div class="mt-auto border-t px-5 py-4 flex items-center justify-between">
            <% if (currentUser) { %>
              <% if (job && job.id) { %>
                <a
                  href="/jobs/<%= job.id %>"
                  class="inline-flex items-center gap-2 text-indigo-700 font-medium hover:text-indigo-900 transition">
                  View details
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              <% } else { %>
                <span class="text-xs text-slate-500">Details unavailable</span>
              <% } %>
              <span class="text-xs text-slate-500">Member access</span>
            <% } else { %>
              <% if (job && job.id) { %>
                <a
                  href="/auth/login?next=/jobs/<%= job.id %>"
                  class="inline-flex items-center gap-2 text-indigo-700 font-medium hover:text-indigo-900 transition">
                  Login to view
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              <% } else { %>
                <a class="inline-flex items-center gap-2 text-slate-400 font-medium">Unavailable</a>
              <% } %>
              <span class="text-xs text-slate-500">Guest preview</span>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <nav class="mt-4 flex items-center justify-center gap-2 flex-wrap" aria-label="Pagination">
        <% const prev = currentPage - 1; const next = currentPage + 1; %>

        <a
          href="/jobs?page=<%= Math.max(1, prev) %>&limit=<%= limit %><%= status ? '&status=' + status : '' %>"
          class="px-4 py-2 rounded-lg border bg-white hover:bg-slate-50 text-sm
          <%= currentPage === 1 ? 'opacity-50 pointer-events-none' : '' %>">
          Prev
        </a>

        <% for (let i = 1; i <= totalPages; i++) { %>
          <a
            href="/jobs?page=<%= i %>&limit=<%= limit %><%= status ? '&status=' + status : '' %>"
            class="px-4 py-2 rounded-lg border text-sm
            <%= i === currentPage
              ? 'bg-slate-900 text-white border-slate-900'
              : 'bg-white hover:bg-slate-50' %>">
            <%= i %>
          </a>
        <% } %>

        <a
          href="/jobs?page=<%= Math.min(totalPages, next) %>&limit=<%= limit %><%= status ? '&status=' + status : '' %>"
          class="px-4 py-2 rounded-lg border bg-white hover:bg-slate-50 text-sm
          <%= currentPage === totalPages ? 'opacity-50 pointer-events-none' : '' %>">
          Next
        </a>
      </nav>
    <% } %>

  </div>
</div>
