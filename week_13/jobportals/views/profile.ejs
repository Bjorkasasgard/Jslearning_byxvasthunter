<section class="space-y-10">

  <% if (!current) { %>
    <!-- NOT AUTH -->
    <div class="min-h-[60vh] flex items-center justify-center">
      <div class="bg-white rounded-2xl border shadow-sm px-8 py-10 text-center max-w-md w-full">
        <h1 class="text-2xl font-bold text-slate-900 mb-2">Access restricted</h1>
        <p class="text-slate-600 mb-6">
          Please sign in to manage your profile and job applications.
        </p>
        <a href="/auth/login"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 font-semibold">
          Login
        </a>
      </div>
    </div>

  <% } else { %>

  <!-- ================= PROFILE HERO ================= -->
  <div class="bg-white border rounded-3xl p-6 shadow-sm flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <p class="text-xs uppercase tracking-wide text-slate-500 mb-1">Candidate Profile</p>
      <h1 class="text-2xl font-bold text-slate-900">
        <%= current.name %>
      </h1>
      <p class="text-sm text-slate-600">
        <%= current.email %>
      </p>
    </div>

    <div class="flex gap-3">
      <span class="px-3 py-1 rounded-full text-xs bg-indigo-50 text-indigo-700 border border-indigo-100">
        Active Candidate
      </span>
    </div>
  </div>

  <!-- ================= GRID ================= -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- ================= PROFILE SETTINGS ================= -->
    <div class="lg:col-span-1">
      <div class="bg-white border rounded-2xl p-5 shadow-sm space-y-4">
        <h2 class="font-semibold text-lg">Profile Settings</h2>

        <form id="profileForm" class="space-y-4">
          <div>
            <label class="text-sm text-slate-600">Full Name</label>
            <input
              id="name"
              class="mt-1 border rounded-lg p-2.5 w-full focus:ring-2 focus:ring-indigo-200"
              value="<%= current.name %>"
            />
          </div>

          <div>
            <label class="text-sm text-slate-600">Email</label>
            <input
              id="email"
              class="mt-1 border rounded-lg p-2.5 w-full focus:ring-2 focus:ring-indigo-200"
              value="<%= current.email || '' %>"
            />
          </div>

          <div>
            <label class="text-sm text-slate-600">
              New Password <span class="text-slate-400">(optional)</span>
            </label>
            <input
              id="password"
              type="password"
              class="mt-1 border rounded-lg p-2.5 w-full focus:ring-2 focus:ring-indigo-200"
              placeholder="••••••••"
            />
          </div>

          <button
            class="w-full mt-2 bg-indigo-600 text-white py-2.5 rounded-lg hover:bg-indigo-700 font-semibold">
            Update Profile
          </button>
        </form>
      </div>
    </div>

    <!-- ================= APPLICATIONS ================= -->
    <div class="lg:col-span-2 space-y-4">

      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold">My Applications</h2>
        <span class="text-sm text-slate-500">
          <%= applications.length %> submitted
        </span>
      </div>

      <ul class="space-y-4">
        <% applications.forEach(a => { %>
          <li class="bg-white border rounded-2xl p-5 shadow-sm hover:shadow transition">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

              <div>
                <h3 class="font-medium text-slate-900">
                  <%= a.jobVacancy.title %>
                </h3>
                <p class="text-sm text-slate-500">
                  <%= a.jobVacancy.company %> ·
                  <%= new Date(a.createdAt).toLocaleDateString() %>
                </p>
              </div>

              <span
                class="px-3 py-1 rounded-full text-xs font-medium
                <%= a.status === 'PENDING'
                  ? 'bg-yellow-50 text-yellow-700 border border-yellow-100'
                  : a.status === 'ACCEPTED'
                  ? 'bg-green-50 text-green-700 border border-green-100'
                  : 'bg-slate-100 text-slate-700 border border-slate-200'
                %>">
                <%= a.status %>
              </span>

            </div>

            <% if (a.coverLetter) { %>
              <p class="mt-3 text-sm text-slate-700 line-clamp-2">
                <strong>Cover Letter:</strong> <%= a.coverLetter %>
              </p>
            <% } %>
          </li>
        <% }) %>

        <% if (!applications.length) { %>
          <li class="bg-white border rounded-2xl p-6 text-center text-slate-500">
            You haven’t applied to any jobs yet.
          </li>
        <% } %>
      </ul>

    </div>
  </div>

  <% } %>
</section>
