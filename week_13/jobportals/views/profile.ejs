<section class="py-10 bg-white">

<% if (!current) { %>
  <div class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center max-w-sm">
      <h1 class="text-2xl font-semibold text-slate-900 mb-2">Sign in required</h1>
      <p class="text-slate-600 mb-6">
        Please sign in to manage your profile and resume.
      </p>
      <a href="/auth/login"
        class="inline-flex items-center px-6 py-2.5 rounded-md bg-indigo-600 text-white hover:bg-indigo-700">
        Sign in
      </a>
    </div>
  </div>

<% } else { %>

<div class="max-w-4xl mx-auto px-6 space-y-14">

  <!-- PROFILE SUMMARY -->
  <div class="flex items-start justify-between gap-6">

    <div class="flex items-center gap-6">
      <div class="w-20 h-20 rounded-full bg-slate-900 text-white flex items-center justify-center text-2xl font-semibold">
        <%= current.name.split(' ').map(n => n[0]).join('').slice(0,2) %>
      </div>

      <div>
        <h1 class="text-3xl font-semibold text-slate-900">
          <%= current.name %>
        </h1>

        <ul class="mt-4 space-y-2 text-slate-700 text-sm">
          <li class="flex items-center gap-3">
            <i data-lucide="mail" class="w-4 h-4 text-slate-400"></i>
            <%= current.email %>
          </li>
          <li class="flex items-center gap-3">
            <i data-lucide="phone" class="w-4 h-4 text-slate-400"></i>
            <%= current.phone || 'Add phone number' %>
          </li>
          <li class="flex items-center gap-3">
            <i data-lucide="map-pin" class="w-4 h-4 text-slate-400"></i>
            <%= current.city || 'Add location' %>
          </li>
        </ul>
      </div>
    </div>

    <button id="editProfileBtn"
      class="inline-flex items-center gap-2 text-sm text-indigo-600 hover:underline">
      <i data-lucide="pencil" class="w-4 h-4"></i>
      Edit profile
    </button>
  </div>

  <!-- VISIBILITY INFO
  <div class="flex items-center gap-3 bg-green-50 border border-green-200 text-green-800 px-5 py-4 rounded-md">
    <i data-lucide="eye" class="w-5 h-5"></i>
    <span class="font-medium">Employers can find your profile</span>
  </div> -->

  <!-- EDIT PROFILE -->
  <form id="profileForm" class="hidden max-w-xl space-y-6">

    <h2 class="text-xl font-semibold text-slate-900">Edit profile</h2>
    <p class="text-sm text-slate-500">
      Update your personal information. Leave password empty if unchanged.
    </p>

    <div class="space-y-4">

      <div>
        <label class="block text-sm font-medium mb-1">Full name</label>
        <input id="name" value="<%= current.name %>"
          class="w-full border rounded-md px-3 py-2 focus:ring-2 focus:ring-indigo-200">
      </div>

      <div>
        <label class="block text-sm font-medium mb-1">Email</label>
        <input id="email" value="<%= current.email %>"
          class="w-full border rounded-md px-3 py-2 focus:ring-2 focus:ring-indigo-200">
      </div>

      <div>
        <label class="block text-sm font-medium mb-1">Phone</label>
        <input id="phone" value="<%= current.phone || '' %>"
          placeholder="e.g. 0857xxxx"
          class="w-full border rounded-md px-3 py-2 focus:ring-2 focus:ring-indigo-200">
      </div>

      <div>
        <label class="block text-sm font-medium mb-1">City</label>
        <input id="city" value="<%= current.city || '' %>"
          placeholder="e.g. Sukabumi"
          class="w-full border rounded-md px-3 py-2 focus:ring-2 focus:ring-indigo-200">
      </div>

      <div>
        <label class="block text-sm font-medium mb-1">New password</label>
        <input id="password" type="password"
          placeholder="Leave blank to keep current password"
          class="w-full border rounded-md px-3 py-2 focus:ring-2 focus:ring-indigo-200">
      </div>

    </div>

    <div class="flex items-center gap-4 pt-2">
      <button type="submit"
        class="px-6 py-2.5 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">
        Save changes
      </button>
      <button type="button" id="cancelEditBtn"
        class="px-4 py-2.5 border rounded-md text-slate-600 hover:bg-slate-50">
        Cancel
      </button>
      <span id="profileMessage" class="text-sm text-slate-500"></span>
    </div>
  </form>

  <!-- RESUME -->
  <div class="border-t pt-10 space-y-4">

    <h2 class="text-xl font-semibold text-slate-900">Resume</h2>
    <p class="text-sm text-slate-500">
      Upload your resume to increase job match opportunities.
    </p>

    <div class="flex flex-wrap gap-4 items-center">
      <input type="file" id="resumeInput" accept=".pdf,.doc,.docx" class="hidden">

      <button id="chooseResumeBtn"
        class="px-6 py-2.5 border rounded-md text-indigo-600 hover:bg-indigo-50">
        Upload resume
      </button>

      <button
        class="px-6 py-2.5 border rounded-md text-slate-500 cursor-not-allowed">
        Build resume (coming soon)
      </button>

      <span id="resumeStatus" class="text-sm text-slate-500"></span>
    </div>

    <% if (current.resume) { %>
      <div class="flex items-center gap-3 text-sm bg-slate-50 border border-slate-200 rounded-lg px-4 py-3">
        <i data-lucide="file" class="w-4 h-4 text-slate-500"></i>
        <a href="<%= current.resume %>" target="_blank" class="text-indigo-600 font-medium hover:underline">
          View my resume
        </a>
        <span class="text-slate-400 text-xs">(opens in new tab)</span>
      </div>
    <% } else { %>
      <div class="text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-4 py-3">
        No resume uploaded yet. Upload one to enable quick apply.
      </div>
    <% } %>

  </div>

</div>

<% } %>
</section>

  <!-- User dialogue overlay -->
  <div id="userDialog" class="fixed inset-0 bg-slate-900/40 hidden items-center justify-center z-50">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full mx-4 p-6 space-y-4 border border-slate-100">
      <div class="flex items-start gap-3">
        <div id="userDialogBadge" class="w-10 h-10 rounded-full flex items-center justify-center text-base font-semibold bg-blue-100 text-blue-700 border border-blue-200">i</div>
        <div class="space-y-1">
          <p id="userDialogTitle" class="text-lg font-semibold text-slate-900">Dialog title</p>
          <p id="userDialogBody" class="text-sm text-slate-600 leading-relaxed">Dialog message</p>
        </div>
      </div>
      <div class="flex justify-end gap-3">
        <button id="userDialogClose" class="px-4 py-2 rounded-md border border-slate-200 text-slate-700 hover:bg-slate-50">Close</button>
      </div>
    </div>
  </div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  lucide.createIcons()

  const editBtn = document.getElementById('editProfileBtn')
  const form = document.getElementById('profileForm')
  const cancelBtn = document.getElementById('cancelEditBtn')
  const profileMessage = document.getElementById('profileMessage')

    // User dialogue helpers
    const dialog = document.getElementById('userDialog')
    const dialogTitle = document.getElementById('userDialogTitle')
    const dialogBody = document.getElementById('userDialogBody')
    const dialogBadge = document.getElementById('userDialogBadge')
    const dialogClose = document.getElementById('userDialogClose')

    const toneStyles = {
      success: 'bg-green-100 text-green-700 border-green-200',
      error: 'bg-rose-100 text-rose-700 border-rose-200',
      info: 'bg-blue-100 text-blue-700 border-blue-200'
    }

    const showDialog = (title, message, tone = 'info') => {
      dialogTitle.textContent = title
      dialogBody.textContent = message
      dialogBadge.className = `w-10 h-10 rounded-full flex items-center justify-center text-base font-semibold ${toneStyles[tone] || toneStyles.info}`
      dialog.classList.remove('hidden')
      dialog.classList.add('flex')
      dialogClose?.focus()
    }

    const hideDialog = () => {
      dialog.classList.add('hidden')
      dialog.classList.remove('flex')
    }

    dialogClose?.addEventListener('click', hideDialog)
    dialog?.addEventListener('click', e => {
      if (e.target === dialog) hideDialog()
    })

  editBtn?.addEventListener('click', () => {
    form.classList.remove('hidden')
    form.scrollIntoView({ behavior: 'smooth', block: 'start' })
  })

  cancelBtn?.addEventListener('click', () => {
    form.classList.add('hidden')
    profileMessage.textContent = ''
  })

  form?.addEventListener('submit', async e => {
    e.preventDefault()
    profileMessage.textContent = 'Saving...'

    const payload = {
      name: document.getElementById('name').value,
      email: document.getElementById('email').value,
      phone: document.getElementById('phone').value,
      city: document.getElementById('city').value,
      password: document.getElementById('password').value || undefined
    }

    try {
      const data = await apiRequest('/api/member/profile', 'PUT', payload)
      profileMessage.textContent = 'Profile updated.'
      showDialog('Profile updated', 'Your changes have been saved successfully.', 'success')
      setTimeout(() => location.reload(), 800)
    } catch (err) {
      profileMessage.textContent = err?.message || 'Update failed'
      showDialog('Update failed', err?.message || 'We could not save your profile. Try again.', 'error')
    }
  })

  const resumeBtn = document.getElementById('chooseResumeBtn')
  const resumeInput = document.getElementById('resumeInput')
  const resumeStatus = document.getElementById('resumeStatus')

  resumeBtn?.addEventListener('click', () => resumeInput.click())

  resumeInput?.addEventListener('change', async () => {
    if (!resumeInput.files[0]) return
    resumeStatus.textContent = 'Uploading...'

    const fd = new FormData()
    fd.append('resume', resumeInput.files[0])

    try {
      // fetch csrf token
      const tokenRes = await fetch('/api/csrf', { credentials: 'same-origin' })
      const tokenJson = await tokenRes.json()
      const headers = {}
      if (tokenJson?.csrfToken) headers['x-csrf-token'] = tokenJson.csrfToken

      const res = await fetch('/api/member/profile/resume', {
        method: 'POST',
        body: fd,
        credentials: 'same-origin',
        headers
      })

      resumeStatus.textContent = res.ok ? 'Resume uploaded.' : 'Upload failed'
      if (res.ok) {
        showDialog('Resume uploaded', 'Your resume has been uploaded successfully.', 'success')
        setTimeout(() => location.reload(), 800)
      } else {
        showDialog('Upload failed', 'Please check the file and try again.', 'error')
      }
    } catch {
      resumeStatus.textContent = 'Upload failed'
      showDialog('Upload failed', 'Please check your connection and try again.', 'error')
    }
  })
})
</script>
