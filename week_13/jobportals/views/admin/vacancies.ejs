<h1 class="text-2xl font-bold mb-4">Vacancy Management</h1>

<table class="w-full bg-white rounded shadow">
    <thead class="bg-gray-100">
        <tr>
            <th class="p-2">Title</th>
            <th class="p-2">Company</th>
            <th class="p-2">Location</th>
            <th class="p-2">Status</th>
            <th><a href="/admin/vacancies/create" class="text-blue-600">+ Create Vacancy</a>
            </th>
        </tr>
    </thead>
    <tbody>
        <% vacancies.forEach(v=> { %>
            <tr class="border-t">
                <td class="p-2">
                    <%= v.title %>
                </td>
                <td class="p-2">
                    <%= v.company %>
                </td>
                <td class="p-2">
                    <%= v.location %>
                </td>
                <td class="p-2">
                    <%= v.status %>
                </td>
            </tr>
            <% }) %>
    </tbody>
</table>