<h1 class="text-2xl font-bold mb-6">Vacancy Management</h1>

<!-- FILTER + CREATE -->
<form
  class="mb-4 flex items-center gap-2"
  method="get"
  action="/admin/vacancies"
>
  <label class="text-sm text-slate-600">Filter by status:</label>

  <select
    name="status"
    onchange="this.form.submit()"
    class="border rounded-lg px-3 py-1.5 text-sm"
  >
    <option value="" <%= !filterStatus ? 'selected' : '' %>>All</option>
    <option value="ACTIVE" <%= filterStatus === 'ACTIVE' ? 'selected' : '' %>>
      ACTIVE
    </option>
    <option value="CLOSED" <%= filterStatus === 'CLOSED' ? 'selected' : '' %>>
      CLOSED
    </option>
  </select>

  <a
    href="/admin/vacancies/create"
    class="ml-auto px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm hover:bg-indigo-700 transition"
  >
    + Create Vacancy
  </a>
</form>

<!-- TABLE -->
<div class="bg-white rounded-xl shadow overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-slate-100 text-slate-600">
      <tr>
        <th class="p-3 text-left">Title</th>
        <th class="p-3 text-left">Company</th>
        <th class="p-3 text-left">Type</th>
        <th class="p-3 text-left">Location</th>
        <th class="p-3 text-left">Status</th>
        <th class="p-3 text-center">Actions</th>
      </tr>
    </thead>

    <tbody>
      <% vacancies.forEach(v => { %>
        <tr class="border-t hover:bg-slate-50 transition">
          <td class="p-3 font-medium"><%= v.title %></td>
          <td class="p-3"><%= v.company %></td>
          <td class="p-3"><%= v.jobType || '-' %></td>
          <td class="p-3"><%= v.location %></td>
          <td class="p-3">
            <span class="px-2 py-1 rounded text-xs
              <%= v.status === 'ACTIVE'
                ? 'bg-green-100 text-green-700'
                : 'bg-red-100 text-red-700'
              %>">
              <%= v.status %>
            </span>
          </td>

          <td class="p-3 text-center space-x-2">
            <a
              href="/admin/vacancies/<%= v.id %>/edit"
              class="px-3 py-1.5 rounded bg-slate-100 hover:bg-slate-200 transition"
            >
              Edit
            </a>

            <button
              onclick="deleteVacancy(<%= v.id %>)"
              class="px-3 py-1.5 rounded bg-red-100 text-red-600 hover:bg-red-200 transition"
            >
              Delete
            </button>
          </td>
        </tr>
      <% }) %>

      <% if (vacancies.length === 0) { %>
        <tr>
          <td colspan="6" class="p-6 text-center text-slate-500">
            No vacancies found
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<script src="/javascripts/api.js"></script>
<script>
  async function deleteVacancy(id) {
    if (!confirm("Are you sure you want to delete this vacancy?")) return;

    try {
      await apiRequest(`/api/admin/vacancies/${id}`, "DELETE");
      window.location.reload();
    } catch (err) {
      alert("Failed to delete vacancy");
    }
  }
</script>
