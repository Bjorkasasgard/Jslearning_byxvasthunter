<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

  <!-- Users Card (Total global) -->
  <div class="bg-white p-4 rounded-2xl shadow hover:shadow-md transition">
    <p class="text-gray-500">Users</p>
    <p class="text-2xl font-bold"><%= stats.usersCount %></p>
  </div>

  <!-- My Vacancies Card -->
  <% if (adminStats) { %>
    <div class="bg-white p-4 rounded-2xl shadow hover:shadow-md transition">
      <p class="text-gray-500">My Vacancies</p>
      <p class="text-2xl font-bold"><%= adminStats.myVacancies %></p>
      <p class="text-sm text-slate-600 mt-2">
        Active: <span class="text-green-600 font-semibold"><%= adminStats.myActive %></span>, 
        Closed: <span class="text-red-600 font-semibold"><%= adminStats.myClosed %></span>
      </p>
    </div>

    <!-- My Applications Card -->
    <div class="bg-white p-4 rounded-2xl shadow hover:shadow-md transition">
      <p class="text-gray-500">My Applications</p>
      <p class="text-2xl font-bold"><%= adminStats.myApplications %></p>
    </div>
  <% } %>

</div>
