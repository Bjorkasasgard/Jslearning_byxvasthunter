<div class="mb-6">
  <p class="text-sm text-slate-500">Admin • Applications</p>
  <h1 class="text-2xl font-semibold text-slate-900">Applications</h1>
  <p class="text-sm text-slate-500 mt-1">
    Tinjau lamaran, resume, cover letter, dan pertanyaan kandidat.
  </p>
</div>

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-slate-600 sticky top-0 z-10">
        <tr>
          <th class="p-4 text-left font-semibold">Applicant</th>
          <th class="p-4 text-left font-semibold">Contact</th>
          <th class="p-4 text-left font-semibold">Job</th>
          <th class="p-4 text-center font-semibold">Resume</th>
          <th class="p-4 text-left font-semibold">Cover Letter</th>
          <th class="p-4 text-left font-semibold">Q & A</th>
          <th class="p-4 text-center font-semibold">Status</th>
          <th class="p-4 text-center font-semibold">Action</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-slate-100">
        <% applications.forEach(a => {
          const resumeLink = a.resumeLink || a.user?.resume || null;
          const coverPdf = a.coverLetterFile || null;
          const qs = a.jobVacancy?.questions || [];
          const answers = a.answers || [];
        %>

        <tr class="hover:bg-slate-50 transition align-top">
          <!-- APPLICANT -->
          <td class="p-4">
            <p class="font-medium text-slate-900">
              <%= a.user?.name || '—' %>
            </p>
            <p class="text-xs text-slate-500">
              <%= a.user?.email || '—' %>
            </p>
          </td>

          <!-- CONTACT -->
          <td class="p-4 text-slate-700">
            <p><%= a.user?.email || '—' %></p>
            <p class="text-xs text-slate-500">
              <%= a.user?.phone || '—' %>
            </p>
          </td>

          <!-- JOB -->
          <td class="p-4 text-slate-800 font-medium">
            <%= a.jobVacancy?.title || '—' %>
          </td>

          <!-- RESUME -->
          <td class="p-4 text-center">
            <% if (resumeLink) { %>
              <a href="<%= resumeLink %>" target="_blank"
                 class="inline-flex items-center gap-1 text-indigo-600 hover:underline font-medium">
                View Resume
              </a>
            <% } else { %>
              <span class="text-slate-400">—</span>
            <% } %>
          </td>

          <!-- COVER LETTER -->
          <td class="p-4 max-w-xs">
            <% if (!a.coverLetter && !coverPdf) { %>
              <span class="text-slate-400">—</span>
            <% } else { %>
              <details class="group">
                <summary class="cursor-pointer text-indigo-600 font-medium">
                  View cover letter
                </summary>

                <div class="mt-2 text-sm text-slate-700 space-y-2">
                  <% if (coverPdf) { %>
                    <a href="<%= coverPdf %>" target="_blank"
                       class="block text-indigo-600 hover:underline">
                      📄 Download PDF
                    </a>
                  <% } %>

                  <% if (a.coverLetter) { %>
                    <p class="whitespace-pre-wrap">
                      <%- a.coverLetter %>
                    </p>
                  <% } %>
                </div>
              </details>
            <% } %>
          </td>

          <!-- Q & A -->
          <td class="p-4 max-w-xs">
            <% if (qs.length === 0) { %>
              <span class="text-slate-400">—</span>
            <% } else { %>
              <details class="group">
                <summary class="cursor-pointer flex items-center gap-2 text-slate-700 font-medium">
                  <svg class="w-4 h-4 group-open:rotate-90 transition"
                       fill="none" stroke="currentColor" stroke-width="2"
                       viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9 5l7 7-7 7" />
                  </svg>
                  Q & A (<%= qs.length %>)
                </summary>

                <div class="mt-3 space-y-3 text-xs">
                  <% qs.forEach((q, i) => { %>
                    <div>
                      <p class="font-semibold text-slate-800">
                        Q<%= i + 1 %>: <%= q %>
                      </p>
                      <p class="text-slate-600 whitespace-pre-wrap">
                        <%= answers[i] || '—' %>
                      </p>
                    </div>
                  <% }) %>
                </div>
              </details>
            <% } %>
          </td>

          <!-- STATUS -->
          <td class="p-4 text-center">
            <select
              id="status-<%= a.id %>"
              onchange="updateStatus(<%= a.id %>)"
              class="rounded-xl border border-slate-200 px-3 py-1.5 text-xs focus:ring-2 focus:ring-indigo-200">
              <% ['PENDING','REVIEWED','ACCEPTED','REJECTED'].forEach(s => { %>
                <option value="<%= s %>" <%= a.status === s ? 'selected' : '' %>>
                  <%= s %>
                </option>
              <% }) %>
            </select>
          </td>

          <!-- ACTION -->
          <td class="p-4 text-center">
            <button
              id="save-<%= a.id %>"
              onclick="saveStatus(<%= a.id %>)"
              class="px-4 py-1.5 rounded-xl bg-emerald-600 text-white text-xs font-medium shadow hover:bg-emerald-700 transition">
              Save
            </button>
          </td>
        </tr>

        <% }) %>

        <% if (applications.length === 0) { %>
          <tr>
            <td colspan="8" class="p-10 text-center text-slate-500">
              Belum ada aplikasi yang masuk.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  function updateStatus(appId) {
    const btn = document.getElementById(`save-${appId}`);
    if (btn) btn.classList.add('ring-2','ring-emerald-300');
  }

  async function saveStatus(appId) {
    const select = document.getElementById(`status-${appId}`);
    const button = document.getElementById(`save-${appId}`);
    if (!select) return;

    const status = select.value;
    select.disabled = true;
    button.disabled = true;
    button.textContent = 'Saving...';

    try {
      const res = await apiRequest(`/api/admin/applications/${appId}`, 'PUT', { status });
      if (res?.status === status) {
        button.textContent = 'Saved';
        setTimeout(() => button.textContent = 'Save', 1200);
      } else {
        alert('Failed to save status.');
      }
    } catch (err) {
      alert(err?.message || 'Error saving status.');
    } finally {
      select.disabled = false;
      button.disabled = false;
      button.classList.remove('ring-2','ring-emerald-300');
    }
  }
</script>
