<h1 class="text-2xl font-bold mb-4">User Management</h1>

<table class="w-full bg-white rounded shadow">
    <thead class="bg-gray-100">
        <tr>
            <th class="p-2">ID</th>
            <th class="p-2">Name</th>
            <th class="p-2">Email</th>
            <th class="p-2">Role</th>
            <th><a href="/admin/users/create" class="text-blue-600">+ Create User</a>
            </th>
        </tr>
    </thead>
    <tbody>
        <% users.forEach(u=> { %>
            <tr class="border-t">
                <td class="p-2">
                    <%= u.id %>
                </td>
                <td class="p-2">
                    <%= u.name %>
                </td>
                <td class="p-2">
                    <%= u.email %>
                </td>
                <td class="p-2">
                    <%= u.role %>
                </td>
            </tr>
            <% }) %>
    </tbody>
</table>