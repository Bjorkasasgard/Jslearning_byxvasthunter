<div class="admin-wrapper">
  <aside class="admin-sidebar">
    <div class="sidebar-header">
      <div class="sidebar-brand">
        <i class="bi bi-balloon-heart-fill"></i>
        <span>Eventify</span>
      </div>
    </div>

    <nav class="sidebar-nav">
      <p class="nav-label">Menu Utama</p>
      <a href="/admin" class="nav-link">
        <i class="bi bi-grid-1x2-fill"></i> Dashboard
      </a>
      <a href="/admin/events/create" class="nav-link">
        <i class="bi bi-calendar-plus-fill"></i> Buat Event
      </a>
      <a href="/admin/tickets" class="nav-link">
        <i class="bi bi-ticket-perforated-fill"></i> Kelola Tiket
      </a>
      <a href="/admin/orders" class="nav-link">
        <i class="bi bi-receipt"></i> Monitoring Pesanan
      </a>

      <p class="nav-label">Data</p>
      <a href="/admin/members" class="nav-link">
        <i class="bi bi-people-fill"></i> Kelola Anggota
      </a>
      <a href="/admin/events" class="nav-link active">
        <i class="bi bi-collection-fill"></i> Daftar Event
      </a>
    </nav>

    <div class="sidebar-footer">
      <a href="/" class="nav-link-secondary">
        <i class="bi bi-box-arrow-up-right"></i> Lihat Website
      </a>
      <form method="POST" action="/api/auth/logout">
        <button type="submit" class="btn-logout">
          <i class="bi bi-power"></i> Logout
        </button>
      </form>
    </div>
  </aside>

  <main class="admin-content">
    <header class="admin-header">
      <div class="header-title">
        <h1>Daftar Event</h1>
        <p>Kelola semua event yang telah dipublikasikan.</p>
      </div>
      <div class="header-actions">
        <a href="/admin/events/create" class="btn-primary">
          <i class="bi bi-plus-lg"></i> Tambah Event
        </a>
      </div>
    </header>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="event-alert event-alert--danger animate-fade-in mb-4">
        <div class="alert-content">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span><%= errorMessage %></span>
        </div>
      </div>
    <% } %>

    <section class="card-panel">
      <div class="card-header flex-between">
        <div class="header-left">
          <h3>Event Aktif</h3>
          <span class="badge-pill"><%= events.length %> Event</span>
        </div>
        <div class="search-box-mini">
          <i class="bi bi-search"></i>
          <input type="text" placeholder="Cari event..." />
        </div>
      </div>

      <div class="card-body p-0">
        <% if (events.length === 0) { %>
          <div class="empty-state">
            <div class="empty-icon-bg">
              <i class="bi bi-calendar-x"></i>
            </div>
            <h4>Belum ada event</h4>
            <p>Mulai buat event pertamamu sekarang juga.</p>
            <a href="/admin/events/create" class="btn-primary mt-2">Buat Event Sekarang</a>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="admin-table hover-table align-middle">
              <thead>
                <tr>
                  <th width="35%">Informasi Event</th>
                  <th width="20%">Jadwal</th>
                  <th width="20%">Lokasi</th>
                  <th width="10%">Tiket</th>
                  <th width="15%" class="text-right">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% events.forEach(e => { 
                   // Logic Status Simple
                   const eventDate = new Date(e.date);
                   const isPast = eventDate < new Date();
                   const statusLabel = isPast ? 'Selesai' : 'Akan Datang';
                   const statusClass = isPast ? 'secondary' : 'success';
                   
                   // Fallback Image
                   const imgSrc = (e.imageSrc || e.imageUrl) ? (e.imageSrc || e.imageUrl) : null;
                %>
                  <tr>
                    <td>
                      <div class="event-meta-cell">
                        <% if (imgSrc) { %>
                          <img src="<%= imgSrc %>" alt="Thumb" class="event-thumb-mini">
                        <% } else { %>
                          <div class="event-icon-bg"><i class="bi bi-calendar4-event"></i></div>
                        <% } %>
                        <div class="event-info-text">
                          <span class="event-name"><%= e.title %></span>
                          <span class="status-dot <%= statusClass %>"><%= statusLabel %></span>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="date-col">
                        <span class="date-main"><%= eventDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                        <span class="date-sub"><%= eventDate.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB</span>
                      </div>
                    </td>
                    <td>
                      <span class="location-text"><i class="bi bi-geo-alt"></i> <%= e.location %></span>
                    </td>
                    <td>
                      <div class="ticket-count-badge">
                        <i class="bi bi-ticket-perforated"></i> <%= e.tickets ? e.tickets.length : 0 %>
                      </div>
                    </td>
                    <td class="text-right">
                      <div class="action-group">
                        <a href="/event/<%= e.id %>" target="_blank" class="btn-icon-soft view" title="Lihat di Web">
                          <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                        <a href="/admin/events/<%= e.id %>/edit" class="btn-icon-soft edit" title="Edit Event">
                          <i class="bi bi-pencil-fill"></i>
                        </a>
                        <form method="POST" action="/admin/events/<%= e.id %>/delete" style="display:inline" onsubmit="return confirm('Yakin hapus event ini? Semua tiket terkait juga akan terhapus.');">
                          <%- include("../../partials/csrf") %>
                          <button type="submit" class="btn-icon-soft delete" title="Hapus Permanen">
                            <i class="bi bi-trash-fill"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </section>
  </main>
</div>