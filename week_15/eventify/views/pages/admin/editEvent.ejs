<div class="admin-wrapper">
  <main class="admin-content">
    <header class="admin-header">
      <div class="header-title">
        <h1>Edit Event</h1>
        <p>Perbarui data event.</p>
      </div>
    </header>
    <section class="card-panel">
      <div class="card-header">
        <h3><i class="bi bi-pencil-square"></i> Edit Event</h3>
      </div>
      <div class="card-body">
        <form class="styled-form" method="POST" action="/admin/events/<%= event.id %>/edit" enctype="multipart/form-data">
          <div class="form-group">
            <label>Judul Event</label>
            <input name="title" type="text" value="<%= event.title %>" />
          </div>
          <div class="form-group">
            <label>Lokasi</label>
            <input name="location" type="text" value="<%= event.location %>" />
          </div>
          <div class="form-group">
            <label>Tanggal & Waktu</label>
            <input name="date" type="datetime-local" value="<%= event.date ? new Date(event.date).toISOString().slice(0,16) : '' %>" />
          </div>
          <div class="form-group">
            <label>Deskripsi</label>
            <textarea name="description" rows="4"><%= event.description %></textarea>
          </div>
          <div class="form-group">
            <label>Gambar Event (opsional)</label>
            <input name="imageFile" type="file" accept="image/*" />
          </div>
          <button class="btn-secondary" type="submit">Simpan Perubahan</button>
          <a href="/admin/events" class="btn-link">Batal</a>
        </form>
      </div>
    </section>
  </main>
</div>
