<div class="admin-wrapper">
  <aside class="admin-sidebar">
    <div class="sidebar-header">
      <div class="sidebar-brand">
        <span>Eventify</span>
      </div>
    </div>

    <nav class="sidebar-nav">
      <p class="nav-label">Menu Utama</p>
      <a href="/admin" class="nav-link">
        <i class="bi bi-grid-1x2-fill"></i> Dashboard
      </a>
      <a href="/admin/events/create" class="nav-link">
        <i class="bi bi-calendar-plus-fill"></i> Buat Event
      </a>
      <a href="/admin/tickets" class="nav-link">
        <i class="bi bi-ticket-perforated-fill"></i> Kelola Tiket
      </a>
      <a href="/admin/orders" class="nav-link active">
        <i class="bi bi-receipt"></i> Monitoring Pesanan
      </a>

      <p class="nav-label">Data</p>
      <a href="/admin/members" class="nav-link">
        <i class="bi bi-people-fill"></i> Kelola Anggota
      </a>
      <a href="/admin/events" class="nav-link">
        <i class="bi bi-collection-fill"></i> Daftar Event
      </a>
    </nav>

    <div class="sidebar-footer">
      <a href="/" class="nav-link-secondary">
        <i class="bi bi-box-arrow-up-right"></i> Lihat Website
      </a>
      <form method="POST" action="/api/auth/logout">
        <button type="submit" class="btn-logout">
          <i class="bi bi-power"></i> Logout
        </button>
      </form>
    </div>
  </aside>

  <main class="admin-content">
    <% const stats = (typeof orderStats !== 'undefined' && orderStats) ? orderStats : { total: 0, paid: 0, unpaid: 0 }; %>

    <header class="admin-header">
      <div class="header-title">
        <h1>Monitoring Pesanan</h1>
        <p>Pantau status pesanan tiket dari event Anda.</p>
      </div>
      <div class="header-user">
        <div class="user-avatar">A</div>
      </div>
    </header>

    <section class="card-panel full-width">
      <div class="card-header flex-between">
        <h3>Daftar Pesanan</h3>
        <div class="header-badges">
          <span class="badge"><%= (orders || []).length %> Pesanan</span>
          <span class="badge badge-success">Paid: <%= stats.paid %></span>
          <span class="badge badge-danger">Unpaid: <%= stats.unpaid %></span>
        </div>
      </div>

      <div class="card-body p-0">
        <% if (!orders || orders.length === 0) { %>
          <div class="empty-state">
            <img src="https://www.svgrepo.com/show/493837/receipt.svg" alt="Empty" style="width: 160px; opacity: 0.75;">
            <h4>Belum ada pesanan</h4>
            <p>Pesanan tiket untuk event Anda akan muncul di sini.</p>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Order</th>
                  <th>Event</th>
                  <th>Pemesan</th>
                  <th>Qty</th>
                  <th>Total</th>
                  <th>Status</th>
                  <th>Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% orders.forEach(o => { %>
                  <tr>
                    <td>
                      <div class="event-cell">
                        <div class="event-icon"><i class="bi bi-receipt"></i></div>
                        <strong>#<%= o.id %></strong>
                      </div>
                      <div class="text-muted-sm"><%= new Date(o.createdAt).toLocaleString('id-ID') %></div>
                    </td>
                    <td>
                      <strong><%= o.eventTitle %></strong>
                    </td>
                    <td>
                      <div><strong><%= o.user && o.user.name ? o.user.name : 'User' %></strong></div>
                      <div class="text-muted-sm"><%= o.user && o.user.email ? o.user.email : '-' %></div>
                    </td>
                    <td><span class="badge"><%= o.totalQty %></span></td>
                    <td><strong>Rp <%= (typeof o.totalPrice === 'number' ? o.totalPrice : 0).toLocaleString('id-ID') %></strong></td>
                    <td>
                      <span class="status-badge status-<%= String(o.status).toLowerCase() %>">
                        <%= o.status %>
                      </span>
                    </td>
                    <td>
                      <div class="status-actions">
                        <form method="POST" action="/admin/orders/<%= o.id %>/status">
                          <%- include("../../partials/csrf") %>
                          <input type="hidden" name="status" value="PAID" />
                          <button type="submit" class="btn-pill success" title="Tandai Paid" <%= String(o.status).toUpperCase() === 'PAID' ? 'disabled' : '' %>>
                            <i class="bi bi-check-circle"></i> Paid
                          </button>
                        </form>
                        <form method="POST" action="/admin/orders/<%= o.id %>/status">
                          <%- include("../../partials/csrf") %>
                          <input type="hidden" name="status" value="UNPAID" />
                          <button type="submit" class="btn-pill danger" title="Tandai Unpaid" <%= String(o.status).toUpperCase() === 'UNPAID' ? 'disabled' : '' %>>
                            <i class="bi bi-x-circle"></i> Unpaid
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </section>
  </main>
</div>
