<div class="admin-wrapper">
  <aside class="admin-sidebar">
    <div class="sidebar-header">
      <div class="sidebar-brand">
        <i class="bi bi-balloon-heart-fill"></i>
        <span>Eventify</span>
      </div>
    </div>

    <nav class="sidebar-nav">
      <p class="nav-label">Menu Utama</p>
      <a href="/admin" class="nav-link">
        <i class="bi bi-grid-1x2-fill"></i> Dashboard
      </a>
      <a href="/admin/events/create" class="nav-link">
        <i class="bi bi-calendar-plus-fill"></i> Buat Event
      </a>
      <a href="/admin/tickets" class="nav-link active">
        <i class="bi bi-ticket-perforated-fill"></i> Kelola Tiket
      </a>
      <a href="/admin/orders" class="nav-link">
        <i class="bi bi-receipt"></i> Monitoring Pesanan
      </a>

      <p class="nav-label">Data</p>
      <a href="/admin/members" class="nav-link">
        <i class="bi bi-people-fill"></i> Kelola Anggota
      </a>
      <a href="/admin/events" class="nav-link">
        <i class="bi bi-collection-fill"></i> Daftar Event
      </a>
    </nav>

    <div class="sidebar-footer">
      <a href="/" class="nav-link-secondary">
        <i class="bi bi-box-arrow-up-right"></i> Lihat Website
      </a>
      <form method="POST" action="/api/auth/logout">
        <button type="submit" class="btn-logout">
          <i class="bi bi-power"></i> Logout
        </button>
      </form>
    </div>
  </aside>

  <main class="admin-content">
    <header class="admin-header">
      <div class="header-title">
        <h1>Manajemen Tiket</h1>
        <p>Atur jenis tiket, harga, dan ketersediaan kuota per event.</p>
      </div>
      <div class="header-user">
        <div class="user-avatar">A</div>
      </div>
    </header>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="event-alert event-alert--danger animate-fade-in mb-4">
        <div class="alert-content">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span><%= errorMessage %></span>
        </div>
      </div>
    <% } %>

    <div class="ticket-layout-grid">
      
      <aside class="ticket-form-sidebar">
        <div class="card-panel sticky-panel">
          <div class="card-header">
            <h3><i class="bi bi-plus-lg"></i> Tambah Tiket Baru</h3>
          </div>
          <div class="card-body">
            <form class="styled-form" method="POST" action="/admin/tickets">
              <%- include("../../partials/csrf") %>
              
              <div class="form-group">
                <label>Target Event</label>
                <div class="select-wrapper">
                  <select name="eventId" required class="form-select">
                    <option value="" disabled selected>-- Pilih Event --</option>
                    <% events.forEach(e => { %>
                      <option value="<%= e.id %>"><%= e.title %></option>
                    <% }) %>
                  </select>
                  <i class="bi bi-chevron-down select-icon"></i>
                </div>
              </div>

              <div class="form-group">
                <label>Nama Kategori</label>
                <input name="name" type="text" placeholder="Misal: Presale 1, VIP, Festival" required />
              </div>

              <div class="form-row compact">
                <div class="form-group">
                  <label>Harga</label>
                  <div class="input-group">
                    <span class="prefix">Rp</span>
                    <input name="price" type="number" min="0" placeholder="0" required />
                  </div>
                </div>

                <div class="form-group">
                  <label>Kuota</label>
                  <input name="quota" type="number" min="1" placeholder="Qty" required />
                </div>
              </div>

              <button class="btn-primary w-100 mt-2" type="submit">
                <i class="bi bi-save"></i> Terbitkan Tiket
              </button>
            </form>

            <div class="info-note mt-3">
              <i class="bi bi-info-circle"></i>
              <small>Tiket akan langsung aktif dan muncul di halaman detail event.</small>
            </div>
          </div>
        </div>
      </aside>

      <section class="ticket-list-section">
        <div class="card-panel">
          <div class="card-header flex-between">
            <h3>Daftar Tiket Aktif</h3>
            <span class="badge-pill"><%= events.reduce((acc, e) => acc + (e.tickets || []).length, 0) %> Item</span>
          </div>

          <div class="card-body p-0">
            <% if (events.length === 0 || events.every(e => !e.tickets || e.tickets.length === 0)) { %>
              <div class="empty-state">
                <div class="empty-icon-bg">
                  <i class="bi bi-ticket-detailed"></i>
                </div>
                <h4>Belum ada tiket</h4>
                <p>Silakan buat tiket baru melalui formulir di samping.</p>
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="admin-table hover-table">
                  <thead>
                    <tr>
                      <th width="30%">Event</th>
                      <th width="25%">Kategori</th>
                      <th width="20%">Harga</th>
                      <th width="10%">Kuota</th>
                      <th width="15%" class="text-right">Aksi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% events.forEach(e => {
                        (e.tickets || []).forEach(t => { %>
                      <tr>
                        <td>
                          <div class="event-meta-cell">
                            <span class="event-dot"></span>
                            <span class="event-name"><%= e.title %></span>
                          </div>
                        </td>
                        <td>
                          <span class="ticket-tag"><%= t.name %></span>
                        </td>
                        <td class="font-bold">
                          Rp <%= t.price.toLocaleString('id-ID') %>
                        </td>
                        <td>
                          <div class="quota-badge">
                            <i class="bi bi-people"></i> <%= t.quota %>
                          </div>
                        </td>
                        <td class="text-right">
                          <div class="action-group">
                            <a href="/admin/tickets/<%= t.id %>/edit" class="btn-icon-soft edit" title="Edit">
                              <i class="bi bi-pencil-fill"></i>
                            </a>
                            <form method="POST" action="/admin/tickets/<%= t.id %>/delete" style="display:inline" onsubmit="return confirm('Hapus tiket ini?');">
                              <%- include("../../partials/csrf") %>
                              <button type="submit" class="btn-icon-soft delete" title="Hapus">
                                <i class="bi bi-trash-fill"></i>
                              </button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    <% })
                    }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      </section>

    </div>
  </main>
</div>