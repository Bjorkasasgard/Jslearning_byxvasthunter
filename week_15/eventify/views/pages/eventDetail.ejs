<% var prices = (tickets || []).map(function(t) { return t.price; }).filter(function(p) { return typeof p === 'number'; }); %>
<% var minPrice = prices.length ? Math.min.apply(null, prices) : null; %>

<div class="event-header-strip">
  <div class="event-header-bg" style="background-image: url('<% if (event && event.imageSrc) { %><%= event.imageSrc %><% } else { %>https://placehold.co/1200x600?text=Event+Cover<% } %>')"></div>
  <div class="container">
    <div class="event-header-content">
      <h1><%= event.title %></h1>
      <div class="event-header-meta">
        <span><i class="bi bi-geo-alt-fill"></i><%= event.location %></span>
        <span><i class="bi bi-calendar-event-fill"></i><%= new Date(event.date).toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'short' }) %> WIB</span>
        <span><i class="bi bi-tag-fill"></i><%= event.category || "Event" %></span>
      </div>
    </div>
  </div>
</div>

<div class="container event-page-container">
  <div class="event-layout-grid">
    <div class="event-left-column">
      <div class="event-tabs" role="tablist">
        <button class="tab-btn active" type="button" data-target="#event-description">Deskripsi</button>
        <button class="tab-btn" type="button" data-target="#ticket-section">Tiket</button>
      </div>


      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="event-alert event-error">
          <i class="bi bi-exclamation-triangle"></i>
          <span><%= decodeURIComponent(errorMessage) %></span>
        </div>
      <% } %>

      <div id="event-description" class="event-description-box">
        <%- (event.description || "").replace(/\n/g, '<br>') %>
      </div>

      <div id="ticket-section" class="event-ticket-section">
        <h3>Tiket</h3>

        <% if (!tickets || tickets.length === 0) { %>
          <div class="event-empty">
            <i class="bi bi-ticket-perforated"></i>
            <span>Tiket belum tersedia.</span>
          </div>
        <% } %>

        <div class="ticket-list-clean">
          <% (tickets || []).forEach(function(t, idx) { %>
            <div class="ticket-item">
              <div class="ticket-info">
                <h4><%= t.name || ('General Admission #' + (idx + 1)) %></h4>
                <p class="ticket-quota">Sisa kuota: <%= t.quota %></p>
                <% if (t.quota && t.quota > 0) { %>
                  <span class="status-badge success">Tersedia</span>
                <% } else { %>
                  <span class="status-badge danger">Sold Out</span>
                <% } %>
                <div class="ticket-desc-small">Termasuk pajak & biaya admin</div>
              </div>
              <div class="ticket-action">
                <div class="ticket-price">Rp <%= t.price.toLocaleString('id-ID') %></div>
                <% if (!isAuthenticated) { %>
                  <a href="/login" class="btn-ticket-outline">Pilih</a>
                <% } else if (t.quota && t.quota > 0) { %>
                  <button
                    type="button"
                    class="btn-ticket-add"
                    onclick="document.getElementById('checkout-select').value='<%= t.id %>'; document.querySelector('.event-right-column').scrollIntoView({behavior: 'smooth'});"
                  >
                    <i class="bi bi-plus-lg"></i> Tambah
                  </button>
                <% } else { %>
                  <button type="button" class="btn-ticket-outline" disabled>Sold Out</button>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <aside class="event-right-column">
      <div class="event-sidebar-card">
        <div class="event-poster-wrapper">
          <% if (event && event.imageSrc) { %>
            <img src="<%= event.imageSrc %>" alt="<%= event.title %>" class="event-poster-img" />
          <% } else { %>
            <img src="https://placehold.co/600x400?text=No+Image" alt="<%= event.title %>" class="event-poster-img" />
          <% } %>
        </div>

        <div class="sidebar-content">
          <div class="sidebar-price-label">Harga mulai dari</div>
          <div class="sidebar-price-amount">
            <% if (minPrice !== null) { %>
              Rp <%= minPrice.toLocaleString('id-ID') %>
            <% } else { %>
              Gratis / Belum Tersedia
            <% } %>
          </div>

          <h3 class="sidebar-title"><%= event.title %></h3>

          <div class="sidebar-meta-list">
            <div class="meta-row">
              <i class="bi bi-geo-alt"></i>
              <span><%= event.location %></span>
            </div>
            <div class="meta-row">
              <i class="bi bi-calendar"></i>
              <span><%= new Date(event.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
            </div>
            <div class="meta-row">
              <i class="bi bi-clock"></i>
              <span><%= new Date(event.date).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB</span>
            </div>
          </div>

          <div class="organizer-info">
            <div class="org-avatar">
              <i class="bi bi-person-circle"></i>
            </div>
            <div class="org-details">
              <span>Diselenggarakan oleh</span>
              <strong><%= event.organizer || 'Eventify Official' %></strong>
            </div>
          </div>

          <div class="sidebar-actions">
            <% if (isAdmin) { %>
              <div class="event-alert"><i class="bi bi-shield-lock"></i> Admin tidak dapat memesan tiket.</div>
            <% } else if (!isAuthenticated) { %>
              <a href="/login" class="btn-buy-block">Login untuk Membeli</a>
            <% } else { %>
                  <form class="checkout-form-mini" method="POST" action="/orders">
                    <%- include("../partials/csrf") %>
                <input type="hidden" name="eventId" value="<%= event.id %>" />
                <div class="mini-field">
                  <label>Pilih Tiket:</label>
                  <select name="ticketId" id="checkout-select" required>
                    <% (tickets || []).forEach(function(t, idx) { %>
                      <option value="<%= t.id %>" <%= t.quota && t.quota > 0 ? '' : 'disabled' %>>
                        <%= t.name || ('General Admission #' + (idx + 1)) %> - Rp <%= t.price.toLocaleString('id-ID') %>
                        <%= t.quota && t.quota > 0 ? '' : ' (Sold Out)' %>
                      </option>
                    <% }) %>
                  </select>
                </div>
                <div class="mini-field qty-field">
                  <label>Jumlah:</label>
                  <input name="quantity" type="number" min="1" value="1" max="5" required />
                </div>
                <button type="submit" class="btn-buy-block">Beli Tiket</button>
              </form>
            <% } %>
          </div>

          <div class="share-section">
            <span>Bagikan Event</span>
            <div class="share-icons"> 
              <a class="share-link" target="_blank" rel="noopener" aria-label="Bagikan ke WhatsApp" href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(event.title + '\n' + (baseUrl + currentPath)) %>"><i class="bi bi-whatsapp"></i></a>
              <a class="share-link" target="_blank" rel="noopener" aria-label="Bagikan ke Facebook" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(baseUrl + currentPath) %>"><i class="bi bi-facebook"></i></a>
              <a class="share-link" target="_blank" rel="noopener" aria-label="Bagikan ke Twitter" href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(event.title) %>&url=<%= encodeURIComponent(baseUrl + currentPath) %>"><i class="bi bi-twitter-x"></i></a>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>

<script>
  (function () {
    const tabs = Array.from(document.querySelectorAll('.tab-btn'));
    const sections = tabs
      .map((tab) => document.querySelector(tab.dataset.target))
      .filter(Boolean);

    if (!tabs.length || !sections.length) return;

    const setActive = (targetId) => {
      tabs.forEach((tab) => {
        tab.classList.toggle('active', tab.dataset.target === `#${targetId}`);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = document.querySelector(tab.dataset.target);
        if (!target) return;
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        });
      },
      {
        rootMargin: '-20% 0px -60% 0px',
        threshold: 0.1,
      }
    );

    sections.forEach((section) => observer.observe(section));
  })();
</script>