<header class="header">
  <div class="container-fluid header__inner">
    <div class="header__left">
      <a class="brand" href="/" aria-label="Eventify home">
        <span class="brand__text">Eventify</span>
      </a>
    </div>

    <form class="header__search" method="GET" action="/" role="search" aria-label="Search events">
      <input
        type="search"
        name="q"
        value="<%= (typeof searchQuery !== 'undefined' ? searchQuery : '') %>"
        placeholder="Cari event seru di sini..."
        autocomplete="off"
      />
      <button type="submit" aria-label="Cari">
        <i class="bi bi-search"></i>
      </button>
    </form>

    <nav class="nav" aria-label="Primary">
      <a class="nav__link" href="/">
        <i class="bi bi-compass icon-lg" aria-hidden="true"></i>
        <span>Jelajahi Event</span>
      </a>
      
      <% if (isAuthenticated && !(typeof isAdmin !== 'undefined' && isAdmin)) { %>
        <a class="nav__link" href="/my/orders">
          <i class="bi bi-receipt" aria-hidden="true"></i>
          <span>Tiket Saya</span>
        </a>
      <% } %>

      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <a class="nav__link" href="/admin">
          <i class="bi bi-speedometer2" aria-hidden="true"></i>
          <span>Admin</span>
        </a>
      <% } %>
    </nav>

    <div class="header__actions">
      <% if (!isAuthenticated) { %>
        <a class="btn-outline-white" href="/register">
          Daftar
        </a>
        <a class="btn-solid-blue" href="/login">
          Masuk
        </a>
      <% } else { %>
        <div class="user-menu">
          <button class="user-menu__trigger" type="button" aria-haspopup="true" aria-expanded="false">
            <i class="bi bi-person-circle"></i>
            <span class="user-menu__name"><%= user.name || user.email %></span>
            <i class="bi bi-chevron-down"></i>
          </button>

          <div class="user-menu__dropdown" role="menu">
            <% if (!(typeof isAdmin !== 'undefined' && isAdmin)) { %>
              <a class="user-menu__item" href="/my/orders" role="menuitem">
                <i class="bi bi-receipt"></i>
                Tiket Saya
              </a>
            <% } %>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
              <a class="user-menu__item" href="/admin" role="menuitem">
                <i class="bi bi-speedometer2"></i>
                Beralih ke Dashboard Admin
              </a>
            <% } %>
            <div class="user-menu__divider"></div>
            <form method="POST" action="/api/auth/logout" class="user-menu__item" role="menuitem">
              <button type="submit" class="user-menu__logout">
                <i class="bi bi-box-arrow-right"></i>
                Keluar
              </button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</header>