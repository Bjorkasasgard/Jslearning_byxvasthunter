generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  avatarData Bytes?
  avatarMime String?
  role      Role     @default(USER)
  orders    Order[]
  events    Event[]
  createdAt DateTime @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  location    String
  date        DateTime
  imageUrl    String?
  imageData   Bytes?
  imageMime   String?
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  tickets     Ticket[]
  createdAt   DateTime @default(now())
}

model Ticket {
  id        Int     @id @default(autoincrement())
  eventId   Int
  name      String?
  price     Int
  quota     Int
  event     Event   @relation(fields: [eventId], references: [id])
  orderItems OrderItem[]
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  items     OrderItem[]
  createdAt DateTime @default(now())
  status    String   @default("UNPAID")
  qrToken   String?
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId  Int
  ticketId Int
  quantity Int

  // Snapshot fields to preserve order details even if ticket/event are later edited
  ticketName   String?
  ticketPrice  Int?
  eventTitle   String?
  eventDate    DateTime?
  eventLocation String?

  order  Order  @relation(fields: [orderId], references: [id])
  ticket Ticket @relation(fields: [ticketId], references: [id])
}
